# Lokale PostgreSQL — Datenbank anlegen z. B. mit:
#   psql -U postgres -h localhost -c "CREATE DATABASE avelom;"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/avelom?schema=public"

# Nitro / Auth — JWT (min. 16 Zeichen in Production)
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: Token-Laufzeiten (jose-kompatible Strings)
# JWT_ACCESS_TTL=8h
# JWT_REFRESH_TTL=30d

# Optional: HttpOnly-Cookie-Name für die Web-Session
# AUTH_COOKIE_NAME=avelom_at

# Capacitor-Hülle (apps/mobile-shell). Wird bei `pnpm cap:sync` aus dieser Datei gelesen.
# Android-Emulator:  http://10.0.2.2:3000
# Physisches Gerät:  http://192.168.x.x:3000  (LAN-IP des Rechners, Nuxt mit --host 0.0.0.0)
# CAPACITOR_SERVER_URL=http://10.0.2.2:3000

# prisma/seed.ts — Demo-Tenant + Nutzer
# SEED_DEMO_EMAIL=demo@avelom.local
# SEED_DEMO_PASSWORD=demo123
# SEED_DEMO_NAME="Demo Admin"
# SEED_TENANT_NAME="Demo Studio"
# SEED_TENANT_SLUG=demo-studio
# SEED_DEMO_IS_SUPERADMIN=true
