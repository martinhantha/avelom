{
  "name": "avelom",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "description": "Avelom (ogama) — multi-tenant scheduling platform",
  "scripts": {
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "dev:web": "pnpm --filter @avelom/web dev",
    "dev:worker": "pnpm --filter @avelom/worker dev"
  },
  "dependencies": {
    "@prisma/client": "6.9.0"
  },
  "devDependencies": {
    "bcryptjs": "^3.0.2",
    "prisma": "6.9.0",
    "tsx": "^4.19.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "vue": "3.5.32",
      "@vue/runtime-core": "3.5.32",
      "@vue/runtime-dom": "3.5.32",
      "@vue/server-renderer": "3.5.32",
      "@vue/shared": "3.5.32"
    }
  }
}
